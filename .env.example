# LibreNMS Docker Compose Environment Variables
# Copy to .env and customize

# Timezone
TZ=UTC

# User/Group IDs for file permissions
PUID=1000
PGID=1000

# Database
DB_NAME=librenms
DB_USER=librenms
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Base URL for LibreNMS web interface
BASE_URL=http://localhost

# Poller settings
POLLERS=16
ENABLE_SYSLOG=true
ENABLE_SNMPTRAP=true