# LibreNMS Docker Compose Environment Variables
# Copy to .env and customize (or run librenms-auto-install.sh which
# generates .env with random credentials automatically).

# Timezone
TZ=UTC

# User/Group IDs for file permissions
PUID=1000
PGID=1000

# Database
DB_NAME=librenms
DB_USER=librenms
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Redis (required — used for cache/queue; must match redis service)
REDIS_PASSWORD=changeme

# Public URL is installer metadata (used in status output / Caddy site address).
BASE_URL=http://localhost
# Official container base path. Subdirectory deployments are not recommended.
LIBRENMS_BASE_URL=/

# HTTP publish mapping for the librenms service (host:container).
# Default public :80. With TLS set to 127.0.0.1:8000:8000.
LIBRENMS_HTTP_PUBLISH=80:8000

# Optional TLS via Caddy (compose profile "tls").
# ENABLE_TLS=false
# TLS_MODE=acme
# CADDY_EMAIL=admin@example.com
# CADDY_SITE_ADDRESS=librenms.example.com
# COMPOSE_PROFILES=tls
# LIBRENMS_HTTP_PUBLISH=127.0.0.1:8000:8000

# Optional SMTP relay via msmtpd (compose profile "mail").
# ENABLE_MAIL=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=on
# SMTP_STARTTLS=on
# SMTP_TLS_CHECKCERT=on
# SMTP_AUTH=on
# SMTP_USER=alerts
# SMTP_PASSWORD=changeme
# SMTP_FROM=alerts@example.com
# COMPOSE_PROFILES=mail
# (combine profiles as COMPOSE_PROFILES=tls,mail)

# Cache / session backends (librenms container)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis

# Dispatcher worker count (applied via lnms config:set by the installer)
POLLERS=16

# SNMP traps (replace every changeme before running Compose manually)
LIBRENMS_SNMP_COMMUNITY=changeme
SNMP_USER=librenms_user
SNMP_AUTH=changeme
SNMP_PRIV=changeme
SNMP_ENGINEID=changeme
SNMP_DISABLE_AUTHORIZATION=no

# Initial admin account (created on first install)
ADMIN_PASS=changeme
ADMIN_EMAIL=admin@example.com
